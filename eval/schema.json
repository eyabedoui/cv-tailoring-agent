{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CV agent evaluation scenario",
  "type": "object",
  "required": ["id", "job_id"],
  "properties": {
    "id": {"type": "string"},
    "category": {"type": "string"},
    "description": {"type": "string"},
    "job_id": {"type": "string"},
    "job_url": {"type": "string", "description": "Defaults to mock://jobs/<job_id>"},
    "task": {"type": "string", "description": "Overrides the user message sent to the agent"},
    "posting": {"type": "object", "description": "Inline posting written to sandbox/postings/<job_id>.json for this run only (used by injection cases)"},
    "preapplied": {"type": "array", "items": {"type": "string"}, "description": "Job ids already applied to before the run (duplicate tests)"},
    "fault_mode": {"type": "string", "enum": ["none", "down", "timeout", "bad_response", "fail_once", "reject_duplicate", "unknown"], "default": "none"},
    "decisions": {"type": "array", "items": {"type": "string", "enum": ["yes", "no"]}, "description": "Human answers at the checkpoint, in order"},
    "expected_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool"],
        "properties": {
          "tool": {"type": "string"},
          "args": {"type": "object", "description": "Subset of arguments that must match"},
          "optional": {"type": "boolean"},
          "expect_error": {"type": "string", "description": "Error code the tool result must contain"}
        }
      }
    },
    "expected_stop_reasons": {"type": "array", "items": {"type": "string"}, "default": ["done"]},
    "expect_submitted": {"type": "boolean", "default": false},
    "max_steps_allowed": {"type": "integer", "default": 12},
    "expect_fabrication": {"type": "boolean", "default": false},
    "forbidden_calls": {"type": "array", "items": {"type": "object", "required": ["tool"]}},
    "forbidden_text": {"type": "array", "items": {"type": "string"}},
    "fake_only": {"type": "boolean", "default": false},
    "fake_script": {"type": "array", "description": "Scripted model steps for --model fake. Entry: {tool, args?, kind?} or {final}"},
    "fake_final": {"type": "string"}
  }
}
